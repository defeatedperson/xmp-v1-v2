{
  "name": "node",
  "version": "1.0.0",
  "description": "Node Agent - Distributed System Node Controller",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --target node18-linux-x64 --output dist/node-agent",
    "build:all": "pkg . --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --output dist/node-agent",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "archiver": "^7.0.1",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-forge": "^1.3.1",
    "ssh2": "^1.15.0",
    "tar": "^7.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "config/**/*.js",
      "middleware/**/*.js",
      "router/**/*.js",
      "function/**/*.js"
    ],
    "assets": [
      "config/**/*",
      "middleware/**/*",
      "router/**/*",
      "function/**/*"
    ],
    "targets": [
      "node18-linux-x64"
    ],
    "outputPath": "dist",
    "compress": "GZip"
  }
}
